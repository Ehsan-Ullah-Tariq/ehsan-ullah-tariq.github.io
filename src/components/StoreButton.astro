---
import type { AppLink } from '../data/apps';

interface Props {
  link: AppLink;
}

const { link } = Astro.props;

const labels = {
  android: { small: 'Get it on', main: 'Google Play' },
  ios: { small: 'Download on the', main: 'App Store' },
  web: { small: 'Open the', main: 'web app' },
  desktop: { small: 'Download for', main: 'desktop' },
} as const;

const label = labels[link.platform];
---

<a class="button store" href={link.url} rel="noopener">
  {
    link.platform === 'android' && (
      <svg width="18" height="20" viewBox="0 0 18 20" aria-hidden="true">
        <path d="M1.5 1.2 16 10 1.5 18.8z" fill="currentColor" />
      </svg>
    )
  }
  {
    link.platform === 'ios' && (
      <svg width="18" height="20" viewBox="0 0 18 20" aria-hidden="true">
        <rect x="3" y="1" width="12" height="18" rx="3" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="M7.5 16h3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    )
  }
  {
    link.platform === 'web' && (
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="M2 10h16M10 2c2.5 2.2 3.5 5 3.5 8s-1 5.8-3.5 8c-2.5-2.2-3.5-5-3.5-8s1-5.8 3.5-8z" fill="none" stroke="currentColor" stroke-width="1.6" />
      </svg>
    )
  }
  {
    link.platform === 'desktop' && (
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
        <rect x="2" y="3" width="16" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="M7 17h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    )
  }
  <span><small>{label.small}</small> {label.main}</span>
</a>

<style>
  .store {
    background: var(--text);
    color: var(--bg);
  }

  .store:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  small {
    font-weight: 500;
    font-size: 0.85em;
    opacity: 0.8;
  }
</style>
