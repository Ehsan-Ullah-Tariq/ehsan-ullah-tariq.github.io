---
interface Props {
  size?: number;
}

const { size = 32 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <linearGradient id="logo-gradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#7b6cf6"></stop>
      <stop offset="1" stop-color="#4b3fd8"></stop>
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="16" fill="url(#logo-gradient)"></rect>
  <path d="M22 18h21v6H29v5h12v6H29v5h14v6H22z" fill="#fff"></path>
</svg>
