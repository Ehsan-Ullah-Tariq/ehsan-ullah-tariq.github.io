---
import { Image } from 'astro:assets';
import { type App, platformList } from '../data/apps';
import StoreButton from './StoreButton.astro';

interface Props {
  app: App;
}

const { app } = Astro.props;
const page = `/apps/${app.slug}/`;
---

<article class="card app">
  <a class="top" href={page}>
    <Image src={app.icon} alt="" width={88} height={88} class="icon" />
    <div>
      <h3>{app.name}</h3>
      <p class="meta muted">
        {[app.downloads && `${app.downloads} downloads`, platformList(app)].filter(Boolean).join(' · ')}
      </p>
    </div>
  </a>
  <p class="tagline">{app.tagline}</p>
  <ul>
    {app.highlights.map((line) => <li>{line}</li>)}
  </ul>
  <div class="actions">
    {app.links.map((link) => <StoreButton link={link} />)}
    <a class="button button-secondary" href={page}>Details</a>
  </div>
</article>

<style>
  .app {
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .top {
    display: flex;
    align-items: center;
    gap: 18px;
    color: inherit;
    text-decoration: none;
  }

  .top:hover h3 {
    color: var(--accent);
  }

  .icon {
    width: 88px;
    height: 88px;
    border-radius: 22px;
    flex-shrink: 0;
    box-shadow: 0 6px 18px rgb(75 63 216 / 0.25);
  }

  .meta {
    font-size: 0.9rem;
    margin-top: 4px;
  }

  .tagline {
    font-size: 1.05rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
    color: var(--muted);
  }

  li {
    position: relative;
    padding-left: 26px;
  }

  li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.55em;
    width: 12px;
    height: 7px;
    border-left: 2.5px solid var(--accent);
    border-bottom: 2.5px solid var(--accent);
    transform: rotate(-45deg);
  }

  .actions {
    margin-top: auto;
    padding-top: 6px;
  }
</style>
