---
import { site } from '../site';
import Logo from './Logo.astro';

const links = [
  { href: '/#apps', label: 'Apps' },
  { href: '/work-with-me/', label: 'Work with me' },
  { href: '/about/', label: 'About' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.startsWith('/#') && path.startsWith(href);
---

<header class="header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <Logo size={34} />
      <span>{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 66px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 750;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    flex-shrink: 0;
  }

  ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: block;
    padding: 8px 12px;
    border-radius: 999px;
    color: var(--muted);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--surface-2);
  }

  @media (max-width: 520px) {
    .brand span {
      display: none;
    }

    nav a {
      padding: 8px 10px;
      font-size: 0.9rem;
    }
  }
</style>
