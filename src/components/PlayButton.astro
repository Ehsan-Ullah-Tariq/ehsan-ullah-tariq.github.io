---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a class="button play" href={href} rel="noopener">
  <svg width="18" height="20" viewBox="0 0 18 20" aria-hidden="true">
    <path d="M1.5 1.2 16 10 1.5 18.8z" fill="currentColor"></path>
  </svg>
  <span><small>Get it on</small> Google Play</span>
</a>

<style>
  .play {
    background: var(--text);
    color: var(--bg);
  }

  .play:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  small {
    font-weight: 500;
    font-size: 0.85em;
    opacity: 0.8;
  }
</style>
