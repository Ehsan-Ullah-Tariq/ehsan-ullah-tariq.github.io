---
import { apps } from '../data/apps';
import { site } from '../site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap columns">
    <div class="about">
      <a class="brand" href="/">
        <Logo size={28} />
        <span>{site.name}</span>
      </a>
      <p class="muted">Android apps by {site.owner}.</p>
    </div>

    <nav aria-label="Apps">
      <h2>Apps</h2>
      <ul>
        {
          apps.map((app) => (
            <li>
              <a href={`/apps/${app.slug}/`}>{app.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Privacy policies">
      <h2>Privacy</h2>
      <ul>
        {
          apps.map((app) => (
            <li>
              <a href={app.privacyPolicy}>{app.name.split(/[:&]/)[0].trim()} privacy policy</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Contact">
      <h2>Contact</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href="/work-with-me/">Work with me</a></li>
        <li><a href={site.github} rel="me">GitHub</a></li>
        <li><a href={site.playDeveloper}>Google Play</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal muted">© {year} {site.owner}</div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 48px 0 28px;
    margin-top: 40px;
  }

  .columns {
    display: grid;
    grid-template-columns: 1.3fr repeat(3, 1fr);
    gap: 32px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 750;
    text-decoration: none;
    margin-bottom: 10px;
  }

  h2 {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  nav a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }

  nav a:hover {
    color: var(--accent);
  }

  .legal {
    margin-top: 40px;
    font-size: 0.9rem;
  }

  @media (max-width: 860px) {
    .columns {
      grid-template-columns: 1fr 1fr;
    }

    .about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
