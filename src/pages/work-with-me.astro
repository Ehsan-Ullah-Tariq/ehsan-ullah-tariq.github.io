---
import Base from '../layouts/Base.astro';
import { mailto, site } from '../site';

// Based on the bio and the work in my own apps. Adjust to the services and terms you want to offer.
const services = [
  {
    title: 'Mobile apps',
    text: 'Native Android apps in Kotlin and Jetpack Compose, or one Kotlin Multiplatform codebase that ships to both Android and iOS.',
  },
  {
    title: 'Web apps and websites',
    text: 'Fast, responsive web apps and sites that work on every screen size, from a product site like this one to a full web application.',
  },
  {
    title: 'Desktop applications',
    text: 'Desktop apps built for real work, sharing code and design with your mobile apps where it makes sense.',
  },
  {
    title: 'Engineering leadership',
    text: 'Leading development teams, setting up architecture that scales, and keeping delivery on track as a development or technical project manager.',
  },
  {
    title: 'Bring an existing app up to date',
    text: 'Modernise old code and screens, update to the latest platform versions, and fix what the app stores are warning about.',
  },
  {
    title: 'Store launch and compliance',
    text: 'Store listings, privacy policies, ads with proper user consent, crash reporting, and release builds that pass review.',
  },
];

const steps = [
  { title: 'Tell me about it', text: 'What you want to build, who it is for, and any deadline. Screenshots or an existing product help.' },
  { title: 'Plan and estimate', text: 'I reply with how I would approach it, what I need from you, and a time and cost estimate.' },
  { title: 'Build in small steps', text: 'You get working builds as features land, so you can try them on your own devices early.' },
  { title: 'Launch and support', text: 'I help with store listings and release, then fix anything that comes up after launch.' },
];
---

<Base
  title="Work with me"
  description={`Hire ${site.owner}: Android, Kotlin Multiplatform, web and desktop development, and engineering leadership.`}
>
  <section class="section intro">
    <div class="wrap section-head">
      <span class="eyebrow">Work with me</span>
      <h1>Software development, start to finish.</h1>
      <p class="lead">
        I'm a software development manager and technical project manager with {site.yearsExperience} years of experience.
        I've led engineering teams and delivered production apps across e-commerce, social platforms and device
        diagnostics, and I design, build and publish my own apps too. I can build your app, or lead the team that does.
      </p>
      <div class="actions">
        <a class="button button-primary" href={mailto('Project enquiry')}>Email me about your project</a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <h2 class="title">What I can help with</h2>
      <div class="grid-3">
        {
          services.map((service) => (
            <div class="card item">
              <h3>{service.title}</h3>
              <p class="muted">{service.text}</p>
            </div>
          ))
        }
      </div>
      <p class="other muted">
        Something else? If it's software, ask. If it isn't a good fit for me, I'll say so and point you somewhere better.
      </p>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <h2 class="title">How it works</h2>
      <ol class="steps">
        {
          steps.map((step, i) => (
            <li class="card item">
              <span class="number">{i + 1}</span>
              <h3>{step.title}</h3>
              <p class="muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <div class="card contact">
        <div>
          <h2>Let's talk</h2>
          <p class="muted">
            Email <a href={`mailto:${site.email}`}>{site.email}</a> and I'll get back to you. You can also see my code on
            <a href={site.github}>GitHub</a>.
          </p>
        </div>
        <a class="button button-primary" href={mailto('Project enquiry')}>Email me</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-bottom: 24px;
  }

  .intro .section-head {
    margin-bottom: 0;
    gap: 18px;
    max-width: 760px;
  }

  .tight {
    padding: 32px 0;
  }

  .title {
    font-size: 1.6rem;
    margin-bottom: 20px;
  }

  .item {
    padding: 24px;
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .other {
    margin-top: 20px;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 20px;
  }

  .number {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 750;
    margin-bottom: 4px;
  }

  .contact {
    padding: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 40px;
  }

  .contact > div {
    display: grid;
    gap: 8px;
    max-width: 620px;
  }

  .contact a:not(.button) {
    overflow-wrap: anywhere;
  }
</style>
